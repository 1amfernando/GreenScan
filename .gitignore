# GreenScan — Schutz vor versehentlichem Commit von Secrets/Build-Artefakten.
# Das Repo ist PUBLIC. Signing-Keys dürfen NIEMALS hier landen.

# --- Signing-Keys / Provisioning (App-Store-Builds) ---
*.keystore
*.jks
*.p12
*.pem
*.mobileprovision
*.cer
*.certSigningRequest
key.properties
store/**/android-signing.keystore

# --- Android-Build (Bubblewrap erzeugt das Projekt lokal) ---
store/android/app/
store/android/.gradle/
store/android/build/
store/android/*.apk
store/android/*.aab
store/android/*.idsig

# --- iOS / Capacitor (lokal generiert) ---
store/ios/node_modules/
store/ios/ios/
store/ios/www/
store/ios/package-lock.json

# --- Node (Repo ist build-step-frei; node_modules nie committen) ---
/node_modules/
# v30.51: lokales Test-Tooling (jsdom). NIE nach main — Cloudflare Pages würde sonst
# einen npm-Build triggern und den statischen Deploy brechen.
/package.json
/package-lock.json

# --- OS / Editor ---
.DS_Store
*.log
