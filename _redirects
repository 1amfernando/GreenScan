# GreenScan v24.13 — Cloudflare Pages Redirects
# Format identisch zu Netlify — Cloudflare Pages unterstützt _redirects vollständig.

# Friendly-URLs
/install    /install.html   200
/offline    /offline.html   200
/app        /index.html     301!

# v29.41: Datenschutz-Seite (Store-Pflicht, ohne Login erreichbar)
/privacy        /privacy.html   200
/datenschutz    /privacy.html   200

# v29.41: Digital Asset Links (Android TWA) — NIE vom SPA-Fallback überschreiben,
# sonst liefert /.well-known/assetlinks.json HTML statt JSON → TWA-Verifikation scheitert.
/.well-known/*  /.well-known/:splat   200

# v33.55: Teilen-Ziel (manifest.json share_target, POST /teilen). Mit aktivem
# Service Worker kommt der POST nie hier an — sw.js nimmt ihn an. OHNE Worker
# (erster Besuch, Worker abgemeldet, Website-Daten geloescht) landete er sonst im
# SPA-Fallback, und der beantwortet einen POST nicht; so sagt die App, warum kein
# Foto da ist. 303: der Browser holt per GET, kein zweiter POST.
/teilen     /?teilen=ohne-sw   303

# SPA-Fallback: alle nicht-existierenden Pfade → App
/*          /index.html     200
