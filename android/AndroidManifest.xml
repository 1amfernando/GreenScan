<?xml version="1.0" encoding="utf-8"?>
<!--
  GreenScan — Android-Huelle.

  Der Paketname ist derselbe wie in `.well-known/assetlinks.json` (ch.greenscan.app),
  damit eine spaetere Play-Auslieferung nicht auf einen zweiten Namen laeuft.

  versionCode/versionName setzt `android/build.sh` aus GS_VERSION in index.html —
  hier stehen bewusst Platzhalter, damit niemand eine dritte Stelle pflegen muss.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ch.greenscan.app"
    android:versionCode="1"
    android:versionName="0.0">

  <!--
    minSdk 23 (Android 6, 2015) — davor gibt es keine Rechte zur Laufzeit, und
    ohne die kann die Huelle die Kamerafrage der Web-Schicht nicht beantworten.

    targetSdk 34, und das ist KEINE Geschmacksfrage: Android 14 verweigert die
    Installation unter targetSdk 23, Android 15 unter 24. Eine Huelle mit
    niedrigem targetSdk liesse sich auf einem aktuellen Telefon gar nicht
    installieren. Uebersetzt wird trotzdem gegen android.jar 23 — targetSdk ist
    eine Zahl im Manifest, kein Bauabhaengigkeit; die Huelle ruft ausschliesslich
    Methoden, die es seit API 23 gibt.
  -->
  <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />

  <!-- Netz: fuer Supabase, KI, Wetter und Kartenkacheln. Die App SELBST
       (index.html, Artenliste, Bibliotheken) liegt im Paket und braucht
       dafuer kein Netz — siehe AssetServer. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- Der Scanner. Ohne CAMERA liefert getUserMedia in einer WebView nichts. -->
  <uses-permission android:name="android.permission.CAMERA" />

  <!-- Standort: Wetter, Fundorte, Karte. Grob genuegt der App, fein ist
       fuer die Fundorte besser — beides wird zur Laufzeit gefragt. -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

  <!-- Die Kamera ist NICHT Pflicht: wer kein Geraet mit Kamera hat, soll die
       App trotzdem installieren koennen (Lexikon, Garten, Kalender). -->
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
  <uses-feature android:name="android.hardware.location" android:required="false" />
  <uses-feature android:name="android.hardware.location.gps" android:required="false" />

  <!--
    Ab targetSdk 30 sieht eine App fremde Anwendungen nur noch, wenn sie sagt,
    wonach sie sucht. Die Huelle schickt drei Arten von Adressen nach draussen.
  -->
  <queries>
    <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
    <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="mailto" /></intent>
    <intent><action android:name="android.intent.action.DIAL" /><data android:scheme="tel" /></intent>
    <intent><action android:name="android.intent.action.GET_CONTENT" /><data android:mimeType="*/*" /></intent>
  </queries>

  <application
      android:label="@string/app_name"
      android:icon="@drawable/ic_launcher"
      android:theme="@style/GreenScanTheme"
      android:allowBackup="false"
      android:usesCleartextTraffic="false"
      android:hardwareAccelerated="true"
      android:supportsRtl="false">

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:screenOrientation="portrait"
        android:windowSoftInputMode="adjustResize"
        android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

  </application>
</manifest>
