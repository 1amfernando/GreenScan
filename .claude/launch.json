{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-python",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8080"],
      "port": 8080
    },
    {
      "name": "static-npx-serve",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "-l", "8081", "."],
      "port": 8081
    }
  ]
}
